{
  "name": "frostjs",
  "version": "0.1.0",
  "description": "Policy-driven, deny-by-default capability linter for JavaScript",
  "author": "Keith Adler <keith.adler@icloud.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithadler/frostjs.git"
  },
  "homepage": "https://github.com/keithadler/frostjs#readme",
  "bugs": {
    "url": "https://github.com/keithadler/frostjs/issues"
  },
  "keywords": [
    "lint",
    "linter",
    "security",
    "capability",
    "policy",
    "csp",
    "content-security-policy",
    "sri",
    "subresource-integrity",
    "supply-chain",
    "eslint-plugin",
    "frost",
    "deny-by-default",
    "static-analysis"
  ],
  "type": "module",
  "bin": {
    "frostjs": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "vite-node scripts/corpus.ts",
    "showcase": "npm run build && vite-node scripts/showcase.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "oxc-parser": "^0.146.0"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vite-node": "^3.0.0"
  }
}
