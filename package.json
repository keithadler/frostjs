{
  "name": "permit",
  "version": "0.1.0",
  "description": "Policy-driven, deny-by-default capability linter for JavaScript",
  "license": "MIT",
  "type": "module",
  "bin": {
    "permit": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml",
    "scripts/action.sh"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "corpus": "vite-node scripts/corpus.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "prepare": "npm run build",
    "showcase": "npm run build && vite-node scripts/showcase.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "oxc-parser": "^0.146.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./package.json": "./package.json"
  }
}
